+<?php
+
+namespace App\Http\Controllers\Admin;
+
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Spatie\Permission\Models\Permission;
+use Spatie\Permission\Models\Role;
+
+/**
+ * Read-only lookups for the admin UI (role dropdowns, permission pickers).
+ * Granting/revoking goes through StaffController so the role-hierarchy
+ * rules in StaffManagementService always apply.
+ */
+class PermissionController extends Controller
+{
+    public function permissions(): JsonResponse
+    {
+        if (! auth('staff')->user()->can('permission.view')) {
+            return response()->json([
+                'message' => 'You do not have permission [permission.view].',
+            ], 403);
+        }
+
+        return response()->json([
+            'permissions' => Permission::where('guard_name', 'staff')
+                ->orderBy('name')
+                ->pluck('name'),
+        ]);
+    }
+
+    public function roles(): JsonResponse
+    {
+        if (! auth('staff')->user()->can('role.view')) {
+            return response()->json([
+                'message' => 'You do not have permission [role.view].',
+            ], 403);
+        }
+
+        return response()->json([
+            'roles' => Role::where('guard_name', 'staff')
+                ->with('permissions:id,name')
+                ->orderBy('name')
+                ->get()
+                ->map(fn (Role $role) => [
+                    'name' => $role->name,
+                    'permissions' => $role->permissions->pluck('name')->values(),
+                ]),
+        ]);
+    }
+}
